{
  "name": "modelduck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local GGUF coding-model server and tuner with an OpenAI-compatible API. Runs on the CPU or a Vulkan GPU; no cloud account required.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js --no-open",
    "test": "node --test tests",
    "test:parallel": "node scripts/test-parallel.mjs",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "ui:shots": "node scripts/capture-screenshots.mjs",
    "bench": "node benchmarks/run.mjs --phase model",
    "bench:full": "node benchmarks/run.mjs --phase model --full-matrix",
    "bench:flash": "node benchmarks/run.mjs --phase model --flash",
    "bench:all": "node benchmarks/run.mjs --phase model && node benchmarks/run.mjs --phase chat",
    "bench:update": "node benchmarks/run.mjs --phase model --update-baseline && node benchmarks/run.mjs --phase chat --update-baseline",
    "bench:update:model": "node benchmarks/run.mjs --phase model --update-baseline",
    "bench:update:full": "node benchmarks/run.mjs --phase model --update-baseline --full-matrix",
    "tune": "node benchmarks/tune-run.mjs",
    "tune:gate": "node benchmarks/tune-gate.mjs",
    "bench:report": "node benchmarks/report.mjs",
    "bench:link": "node benchmarks/link.mjs",
    "bench:model": "node benchmarks/run.mjs --phase model",
    "bench:chat": "node benchmarks/run.mjs --phase chat",
    "bench:merge": "node benchmarks/merge-shards.mjs",
    "bench:curve": "node benchmarks/context-curve.mjs",
    "verify:manifest": "node benchmarks/verify-manifest.mjs"
  },
  "dependencies": {
    "node-llama-cpp": "3.22.2"
  }
}
